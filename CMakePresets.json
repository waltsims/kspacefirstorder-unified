{
  "$schema": "https://cmake.org/cmake/help/v3.24/manual/cmake-presets.7.json",
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "include": [],
  "vendor": {
    "notes": "Presets wired for vcpkg manifest mode using the bundled third-party/vcpkg clone by default."
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": null,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_FIND_PACKAGE_PREFER_CONFIG": "ON",
        "HDF5_PREFER_PARALLEL": "OFF"
      },
      "environment": {
        "VCPKG_ROOT": "${sourceDir}/third-party/vcpkg",
        "VCPKG_FEATURE_FLAGS": "manifests,registries,binarycaching"
      }
    },
    {
      "name": "linux-openmp",
      "inherits": "base",
      "displayName": "Linux OpenMP (x64)",
      "condition": {
        "type": "equals",
        "lhs": "$env{OS_NAME}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "USE_OPENMP": "ON",
        "USE_CUDA": "OFF"
      },
      "environment": {
        "VCPKG_DEFAULT_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "macos-openmp",
      "inherits": "base",
      "displayName": "macOS OpenMP (x64)",
      "condition": {
        "type": "equals",
        "lhs": "$env{OS_NAME}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "USE_OPENMP": "ON",
        "USE_CUDA": "OFF"
      },
      "environment": {
        "VCPKG_DEFAULT_TRIPLET": "x64-osx"
      }
    },
    {
      "name": "windows-openmp",
      "inherits": "base",
      "displayName": "Windows OpenMP (x64)",
      "condition": {
        "type": "equals",
        "lhs": "$env{OS}",
        "rhs": "Windows_NT"
      },
      "cacheVariables": {
        "USE_OPENMP": "ON",
        "USE_CUDA": "OFF"
      },
      "environment": {
        "VCPKG_DEFAULT_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "linux-cuda",
      "inherits": "base",
      "displayName": "Linux CUDA (x64)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "USE_OPENMP": "OFF",
        "USE_CUDA": "ON"
      },
      "environment": {
        "VCPKG_DEFAULT_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "windows-cuda",
      "inherits": "base",
      "displayName": "Windows CUDA (x64)",
      "cacheVariables": {
        "USE_OPENMP": "OFF",
        "USE_CUDA": "ON"
      },
      "environment": {
        "VCPKG_DEFAULT_TRIPLET": "x64-windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-openmp",
      "configurePreset": "linux-openmp",
      "displayName": "Build Linux OpenMP (x64)",
      "jobs": 0
    },
    {
      "name": "macos-openmp",
      "configurePreset": "macos-openmp",
      "displayName": "Build macOS OpenMP (x64)",
      "jobs": 0
    },
    {
      "name": "windows-openmp",
      "configurePreset": "windows-openmp",
      "displayName": "Build Windows OpenMP (x64)"
    },
    {
      "name": "linux-cuda",
      "configurePreset": "linux-cuda",
      "displayName": "Build Linux CUDA (x64)",
      "jobs": 0
    },
    {
      "name": "windows-cuda",
      "configurePreset": "windows-cuda",
      "displayName": "Build Windows CUDA (x64)"
    }
  ]
}

